  {
    "capabilityId": "harness.plan.submit",
    "toolName": "submit_plan",
    "rpcMethod": null,
    "localExecution": true,
    "description": "Propose a plan of server operations for the user to approve before anything executes.",
    "inputShape": {
      "goal": {
        "type": "string",
        "optional": false,
        "description": "One sentence: what the user asked for and what the plan will accomplish."
      },
      "steps": {
        "type": "string",
        "optional": false,
        "description": "JSON array of step objects, one per action, in execution order. Each object: id (short, stable), title (imperative), toolName (the tool the step will call), sessionId or sessionIds (target session(s)), args (exact structured tool arguments; required for non-terminal actions), command (exact terminal command), reason (why this step is needed), verification (how the step proves it worked), risk (read|low|high). Approved write steps are matched against their exact arguments."
      },
      "preconditions": {
        "type": "string",
        "optional": true,
        "description": "JSON array of prerequisite checks the plan depends on, in the form [{id, label, ok, detail?}]. Every precondition must be ok=true; a false precondition blocks the plan."
      },
      "proxyRisk": {
        "type": "string",
        "optional": true,
        "description": "Set to true when this plan could interrupt the proxy path (proxy service, firewall, routes, DNS, port forwards). The plan is then blocked unless backupAccess passes."
      },
      "backupAccess": {
        "type": "string",
        "optional": true,
        "description": "Required when proxyRisk is true. JSON object keyed by check id: backup-connection, alternate-route, config-backup, recovery-plan. Each value is {ok, detail}. The harness verifies backup-connection from live sessions and requires recovery-plan to name the procedure; model-only declarations for alternate-route and config-backup remain unverified and fail closed until host-bound tool-result evidence exists."
      }
    },
    "policy": {
      "write": false,
      "sensitiveRead": false,
      "longRunning": false,
      "requiresChatSession": true,
      "bypassesObserverBlock": false,
      "bypassesApproval": true,
      "bypassesChatCancel": true
    }
  },
